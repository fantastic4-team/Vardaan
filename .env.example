# Public site URL, used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Signs login sessions. Required in production: any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# AI model (free). Set ONE of these. Get a key at https://console.groq.com or https://aistudio.google.com
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: override the model, or use any OpenAI-compatible server (e.g. a local Ollama:
# LLM_BASE_URL=http://localhost:11434/v1 and LLM_MODEL=llama3.1).
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Web search for the agent. Optional — without one, Vardaan uses DuckDuckGo (limited but free).
# Tavily: https://tavily.com (free tier: 1000 searches/month)
TAVILY_API_KEY=
# Brave Search: https://api.search.brave.com (free tier: 2000 queries/month)
BRAVE_API_KEY=

# Real phone calls and SMS (Twilio). The free trial includes credit and can call numbers you verify.
# Find these on console.twilio.com. PUBLIC_URL is the https address Twilio uses to reach this app:
# your ngrok URL while testing locally (e.g. https://abcd-1234.ngrok-free.app), your domain in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_URL=

# Optional: send approved emails for real. Free with Gmail + an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
