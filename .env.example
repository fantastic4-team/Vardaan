# Public site URL, used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Signs login sessions. Required in production: any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# AI model (free). Set ONE of these. Get a key at https://console.groq.com or https://aistudio.google.com
GROQ_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# Optional: OpenAI API (needs API credit at platform.openai.com; a ChatGPT plan doesn't include it).
# When set it's tried first, and Vardaan falls back to Groq/Gemini if it errors or runs out of credit.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# Optional: override the model, or use any OpenAI-compatible server (e.g. a local Ollama:
# LLM_BASE_URL=http://localhost:11434/v1 and LLM_MODEL=llama3.1).
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Web search for the agent. Optional — without one, Vardaan uses DuckDuckGo (limited but free).
# Tavily: https://tavily.com (free tier: 1000 searches/month)
TAVILY_API_KEY=
# Brave Search: https://api.search.brave.com (free tier: 2000 queries/month)
BRAVE_API_KEY=

# Real phone calls on a Sarvam number (Sarvam Voice Agents, https://dashboard.sarvam.ai).
# Step-by-step setup, including where to find each ID: docs/SARVAM_SETUP.md
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_PHONE_NUMBER=
# Any long random string. Sarvam sends it back (tool auth + webhook ?token=) so only it can drive calls.
SARVAM_WEBHOOK_SECRET=
# The fixed https address Sarvam uses to reach this app: an ngrok static domain while testing
# locally (e.g. https://your-name.ngrok-free.app), your domain in production.
PUBLIC_URL=
# ngrok (free): `npm run tunnel` puts PUBLIC_URL online. dashboard.ngrok.com > Your Authtoken
NGROK_AUTHTOKEN=
# If Sarvam's calling API rejects SARVAM_API_KEY, put the Samvaad workspace key here.
SARVAM_AGENT_API_KEY=

# Optional: Google Calendar + Gmail for the agent (free). Setup: docs/GOOGLE_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Time zone for reading and booking events. Default Asia/Kolkata.
# APP_TIMEZONE=Asia/Kolkata

# Optional: send approved emails for real. Free with Gmail + an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
